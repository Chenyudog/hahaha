# 复制本文件为 server/.env 并填入真实值（.env 含密钥，已被 .gitignore 排除）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_MODEL=deepseek-flash

# 花费折算单价（元/百万 token），以 DeepSeek 平台价目表为准
PRICE_PROMPT_PER_M=2.13
PRICE_COMPLETION_PER_M=8.52

# 服务监听与配对
HOST=0.0.0.0
PORT=8000
PAIR_CODE=改成你自己的配对码
