[Unit]
Description=TimeMaster server (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/cyd/hahaha_ws/server
ExecStart=/home/cyd/hahaha_ws/server/.venv/bin/python /home/cyd/hahaha_ws/server/run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
