[Unit]
Description=TimeMaster server (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cyd
WorkingDirectory=/home/cyd/hahaha_ws/server
# 依赖通过 pip3 install --user 安装在 /home/cyd/.local，以 cyd 用户运行即可加载
ExecStart=/usr/bin/python3 /home/cyd/hahaha_ws/server/run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
